# Copy to .env and adjust. Compose and the Makefile read these;
# the defaults below work out of the box for local dev.

POSTGRES_USER=pulsar
POSTGRES_PASSWORD=pulsar
POSTGRES_DB=pulsar
POSTGRES_PORT=5432

# core (native dev run)
DATABASE_URL=postgres://pulsar:pulsar@localhost:5432/pulsar?sslmode=disable

# Remote ComfyUI when not running the gpu profile locally
# (README: requires a CUDA GPU or a COMFY_URL pointing at a remote ComfyUI).
# Comma-separate for multi-GPU: one URL per ComfyUI process.
COMFY_URL=http://localhost:8188

# core defaults — override as needed
#PORT=8080
#CORS_ORIGINS=*                     # comma-separated origins; empty disables CORS
#WORKFLOWS_DIR=../workflows
#DATA_DIR=./data
#CHECKPOINT=illustrious-xl.safetensors
#LINEAGE=illustrious
# prompt config — values live here, not in code (repo rule).
# QUALITY_TAGS is the positive quality preset for LINEAGE (applied unless a
# request sends quality_tags=false). Keep it matched to the model family —
# wrong-family tags silently kill accuracy (docs/tagdb.md). For
# LINEAGE=noobai append: very awa
QUALITY_TAGS=masterpiece, best quality, very aesthetic, absurdres
# DEFAULT_UC is the quality UC preset (applied unless a request sends
# uc_preset=false); unset means no preset, which visibly degrades output.
# FORBIDDEN_TAG_UC is the forbidden-tag negative — age suppression first
# among them (CLAUDE.md non-negotiables): REQUIRED, the server refuses to
# boot and assembly refuses to build without it. Extend it freely; weakening
# it is on your conscience and your jurisdiction's laws. The phase-4 output
# classifier is the real gate.
DEFAULT_UC=lowres, worst quality, bad quality, bad anatomy, bad hands, jpeg artifacts, signature, watermark
FORBIDDEN_TAG_UC=loli, shota, child, toddler, aged down
#EXEC_TIMEOUT=5m
# seed-tags ingest floor (skip tags the model never learned). The server
# reuses it as the live-validation floor: live-found tags below it are
# reported but never ground and never enter the DB.
#MIN_POST_COUNT=50
# live tag validation (GET /tags/lookup + the grounding cascade's live
# stage): DB misses are checked against Danbooru itself and written through,
# so brand-new tags (yesterday's character debut) validate without a reseed.
# Set empty to disable the stage entirely (air-gapped deployments).
#DANBOORU_URL=https://danbooru.donmai.us

# natural-language → tag translation (POST /translate). Pick a provider and
# set its key; without one the endpoint returns 503 and everything else
# works normally.
#TRANSLATE_PROVIDER=claude          # claude | deepseek
#ANTHROPIC_API_KEY=sk-ant-...
#ANTHROPIC_MODEL=claude-opus-4-8
#DEEPSEEK_API_KEY=sk-...
#DEEPSEEK_MODEL=deepseek-v4-flash   # deepseek-chat is discontinued 2026-07-24
#DEEPSEEK_BASE_URL=https://api.deepseek.com

# integration/e2e tests (make dev creates the postgres; create the db once:
#   docker compose exec postgres psql -U pulsar -c "CREATE DATABASE pulsar_test")
#PULSAR_TEST_DATABASE_URL=postgres://pulsar:pulsar@localhost:5432/pulsar_test?sslmode=disable
